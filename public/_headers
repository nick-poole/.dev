# Netlify serves .txt as text/plain by default. Pinning it here so /llms.txt can
# never be handed back as application/octet-stream, which turns a file meant to
# be read into a file that downloads.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Self-hosted fonts. The filename pins the family, weight, and subset, so the
# bytes behind a given path never change — a year-long immutable cache is safe,
# and a repeat visitor never re-requests them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
